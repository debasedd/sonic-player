# Sonic Spotify credentials
#
# Copy this file to `.env` and fill in the values, or export them in your shell.
# Both are optional: the Client ID can also be pasted in Settings.
#
# No client secret is required or used. Sonic authenticates with PKCE.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SONIC_SPOTIFY_CLIENT_ID=

# Loopback port used only during sign-in. Must be allow-listed in the dashboard
# as http://127.0.0.1:<port>/callback
SONIC_SPOTIFY_REDIRECT_PORT=8976